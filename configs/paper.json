{
  "base_model": "models/Qwen2.5-0.5B-Instruct",
  "routing_encoder": "models/potion-base-2M",
  "reference_bank": "artifacts/nlp_references.npz",
  "device": "cuda:0",
  "dtype": "float32",
  "top_k": 3,
  "temperature": 0.8,
  "batch_size": 32,
  "cpu_threads": 8,
  "references_per_expert": 200,
  "seed": 42,
  "lora": {
    "r": 8,
    "lora_alpha": 32,
    "lora_dropout": 0.1,
    "bias": "none",
    "target_modules": ["gate_proj", "up_proj", "down_proj"]
  },
  "experts": [
    {"name": "cola", "adapter": "experts/cola", "references": "data/cola.references.jsonl"},
    {"name": "mnli", "adapter": "experts/mnli", "references": "data/mnli.references.jsonl"},
    {"name": "mrpc", "adapter": "experts/mrpc", "references": "data/mrpc.references.jsonl"},
    {"name": "qnli", "adapter": "experts/qnli", "references": "data/qnli.references.jsonl"},
    {"name": "qqp", "adapter": "experts/qqp", "references": "data/qqp.references.jsonl"},
    {"name": "rte", "adapter": "experts/rte", "references": "data/rte.references.jsonl"},
    {"name": "sst2", "adapter": "experts/sst2", "references": "data/sst2.references.jsonl"},
    {"name": "stsb", "adapter": "experts/stsb", "references": "data/stsb.references.jsonl"}
  ]
}
